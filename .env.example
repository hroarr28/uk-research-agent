# Copy to .env and export the variables in your shell. Replay mode needs none of these.
# Default path is local Ollama (provider id: ollama). Ollama must already be running;
# this repo does not install it. npm run eval:local reads the OLLAMA_* variables.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
# Optional per-request timeout in milliseconds. Default 300000. HTTP is not retried.
OLLAMA_TIMEOUT_MS=
COMPANIES_HOUSE_API_KEY=
# Optional paid providers for npm run eval:live. Uncomment one provider and its key.
# RESEARCH_PROVIDER accepts openai or anthropic. The local path does not read it.
# RESEARCH_PROVIDER=openai
# OPENAI_API_KEY=
# RESEARCH_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# Optional. Overrides the paid default (gpt-5-mini or claude-sonnet-4-5).
# RESEARCH_MODEL=
# Optional. Example: http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# json (default) or console
TRACE_EXPORTER=json
