# Copy to .env and export the variables in your shell. Replay mode needs none of these.
# Local zero-cost path. Ollama must already be running; this repo does not install it.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:31b
# Optional per-request timeout in milliseconds. Default 300000. HTTP is not retried.
OLLAMA_TIMEOUT_MS=
COMPANIES_HOUSE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RESEARCH_PROVIDER=openai
RESEARCH_MODEL=
# Optional. Example: http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
# json (default) or console
TRACE_EXPORTER=json
